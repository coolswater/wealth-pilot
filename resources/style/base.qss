/**
 * WealthPilot 基础样式表 v2.0
 * 所有主题共用的样式定义
 * 
 * 注意：Qt QSS 不支持 CSS 变量或 Sass 变量
 * 所有颜色变量由 ThemeManager 在运行时替换 ${variable} 占位符
 */

/* ==================== 全局重置 ==================== */
* {
    margin: 0;
    padding: 0;
}

/* ==================== 字体系统 ==================== */
QWidget {
    font-family: 'Roboto', 'Microsoft YaHei', 'PingFang SC', sans-serif;
    color: ${textPrimary};
}

/* ==================== 滚动条样式（通用）==================== */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 4px 2px;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 2px 4px;
    border-radius: 4px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    min-height: 20px;
    min-width: 20px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.3);
}

QScrollBar::add-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:vertical,
QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:vertical,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==================== 工具提示 ==================== */
QToolTip {
    background-color: ${bgElevated};
    color: ${textPrimary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ==================== 菜单样式 ==================== */
QMenu {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 8px;
    padding: 4px 0;
}

QMenu::item {
    padding: 8px 16px;
    color: ${textPrimary};
}

QMenu::item:selected {
    background-color: ${bgHover};
}

QMenu::separator {
    height: 1px;
    background-color: ${border};
    margin: 4px 8px;
}

/* ==================== 分隔线 ==================== */
QFrame[lineType="horizontal"] {
    background-color: ${border};
    max-height: 1px;
    border: none;
}

QFrame[lineType="vertical"] {
    background-color: ${border};
    max-width: 1px;
    border: none;
}

/* ==================== 分组框 ==================== */
QGroupBox {
    font-weight: 600;
    font-size: 14px;
    color: ${textPrimary};
    border: 1px solid ${border};
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    background-color: ${bgPrimary};
    color: ${textPrimary};
}

/* ==================== 标签页 ==================== */
QTabWidget::pane {
    border: 1px solid ${border};
    border-radius: 8px;
    background-color: ${bgSecondary};
}

QTabBar::tab {
    background-color: transparent;
    color: ${textSecondary};
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: ${bgSecondary};
    color: ${textPrimary};
    border: 1px solid ${border};
    border-bottom: none;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: ${bgHover};
    color: ${textPrimary};
}

/* ==================== 进度条 ==================== */
QProgressBar {
    background-color: ${bgSecondary};
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: ${primary};
    border-radius: 4px;
}

/* ==================== 滑块 ==================== */
QSlider::groove:horizontal {
    background-color: ${bgSecondary};
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: ${primary};
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: ${primaryHover};
}

/* ==================== 复选框 ==================== */
QCheckBox {
    color: ${textPrimary};
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid ${border};
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: ${primary};
    border-color: ${primary};
}

QCheckBox::indicator:hover {
    border-color: ${primary};
}

/* ==================== 单选按钮 ==================== */
QRadioButton {
    color: ${textPrimary};
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid ${border};
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: ${primary};
    border-color: ${primary};
}

QRadioButton::indicator:hover {
    border-color: ${primary};
}

/* ==================== 表格视图 ==================== */
QTableView,
QTableWidget {
    background-color: transparent;
    alternate-background-color: ${bgSecondary};
    gridline-color: transparent;
    border: 1px solid ${border};
    border-radius: 8px;
    selection-background-color: rgba(88, 166, 255, 0.15);
    selection-color: ${textPrimary};
}

QTableView::item,
QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid ${border};
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: rgba(88, 166, 255, 0.15);
}

QHeaderView::section {
    background-color: ${bgSecondary};
    color: ${textSecondary};
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid ${border};
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: ${bgHover};
}

/* ==================== 树形视图 ==================== */
QTreeView,
QTreeWidget {
    background-color: transparent;
    border: 1px solid ${border};
    border-radius: 8px;
    selection-background-color: rgba(88, 166, 255, 0.15);
}

QTreeView::item,
QTreeWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QTreeView::item:selected,
QTreeWidget::item:selected {
    background-color: rgba(88, 166, 255, 0.15);
}

QTreeView::item:hover,
QTreeWidget::item:hover {
    background-color: ${bgHover};
}

/* ==================== 列表视图 ==================== */
QListView,
QListWidget {
    background-color: transparent;
    border: 1px solid ${border};
    border-radius: 8px;
    selection-background-color: rgba(88, 166, 255, 0.15);
}

QListView::item,
QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
}

QListView::item:selected,
QListWidget::item:selected {
    background-color: rgba(88, 166, 255, 0.15);
}

QListView::item:hover,
QListWidget::item:hover {
    background-color: ${bgHover};
}

/* ==================== 文本编辑 ==================== */
QTextEdit,
QPlainTextEdit {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 8px;
    padding: 8px;
    color: ${textPrimary};
    selection-background-color: rgba(88, 166, 255, 0.3);
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: ${primary};
}

/* ==================== 日期时间控件 ==================== */
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 6px 12px;
    color: ${textPrimary};
}

QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border-color: ${primary};
}

QDateEdit::drop-down,
QTimeEdit::drop-down,
QDateTimeEdit::drop-down {
    border: none;
    width: 24px;
}

QCalendarWidget {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 8px;
}

QCalendarWidget QToolButton {
    color: ${textPrimary};
    background-color: transparent;
}

/* ==================== 消息框 ==================== */
QMessageBox {
    background-color: ${bgElevated};
}

QMessageBox QLabel {
    color: ${textPrimary};
}

/* ==================== 输入对话框 ==================== */
QInputDialog {
    background-color: ${bgElevated};
}

/* ==================== 属性选择器样式 ==================== */

/* 状态指示器 */
QLabel[status="connected"] {
    color: ${success};
}

QLabel[status="disconnected"] {
    color: ${danger};
}

QLabel[status="connecting"] {
    color: ${warning};
}

/* 涨跌颜色 */
QLabel[trend="up"],
QLabel[dataType="up"] {
    color: ${danger};
}

QLabel[trend="down"],
QLabel[dataType="down"] {
    color: ${success};
}

/* 数据类型标签 */
QLabel[dataType="label"] {
    color: ${textSecondary};
    font-size: 12px;
}

QLabel[dataType="value"] {
    color: ${textPrimary};
    font-weight: 500;
}

QLabel[dataType="change"] {
    font-weight: 600;
}

/* 卡片主题 */
QWidget[cardTheme="primary"] {
    border-left: 3px solid ${primary};
}

QWidget[cardTheme="success"] {
    border-left: 3px solid ${success};
}

QWidget[cardTheme="warning"] {
    border-left: 3px solid ${warning};
}

QWidget[cardTheme="danger"] {
    border-left: 3px solid ${danger};
}

/* 按钮尺寸 */
QPushButton[buttonSize="small"] {
    padding: 4px 12px;
    font-size: 12px;
}

QPushButton[buttonSize="large"] {
    padding: 12px 24px;
    font-size: 16px;
}

/* 禁用状态 */
QWidget[enabled="false"],
QWidget:disabled {
    opacity: 0.5;
}
