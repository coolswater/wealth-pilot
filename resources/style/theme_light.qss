/**
 * WealthPilot 浅色主题样式表 v1.0
 * 基于 WealthPilot UI 设计规范
 * 
 * 颜色变量（由 ThemeManager 替换）：
 * ${bgPrimary} - 主背景色: #F8FAFC
 * ${bgSecondary} - 次背景色: #FFFFFF
 * ${bgElevated} - 提升背景色: #FFFFFF
 * ${bgSurface} - 表面背景色: #F1F5F9
 * ${textPrimary} - 主文本色: #1E293B
 * ${textSecondary} - 次文本色: #64748B
 * ${primary} - 主品牌色: #3B82F6
 * ${success} - 成功色: #10B981
 * ${danger} - 危险色: #EF4444
 * ${warning} - 警告色: #F97316
 * ${border} - 边框色: #E2E8F0
 */

/* ==================== 全局样式 ==================== */
QWidget {
    background-color: ${bgPrimary};
    color: ${textPrimary};
    font-family: 'Roboto', 'Microsoft YaHei', 'PingFang SC', sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: ${bgPrimary};
}

/* ==================== 滚动条 ==================== */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 4px 2px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 2px 4px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==================== 按钮 ==================== */
QPushButton {
    background-color: transparent;
    color: ${textPrimary};
    border: none;
    padding: 10px 20px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QPushButton:pressed {
    background-color: rgba(0, 0, 0, 0.1);
}

QPushButton:disabled {
    background-color: rgba(0, 0, 0, 0.02);
    color: ${textDisabled};
}

/* 主按钮 */
QPushButton[primary="true"] {
    background-color: ${primary};
    color: white;
    font-weight: bold;
}

QPushButton[primary="true"]:hover {
    background-color: #2563EB;
}

QPushButton[primary="true"]:pressed {
    background-color: #1D4ED8;
}

/* 次要按钮 */
QPushButton[secondary="true"] {
    background-color: ${bgSecondary};
    color: ${textPrimary};
    border: 1px solid ${border};
}

QPushButton[secondary="true"]:hover {
    background-color: ${bgSurface};
    border-color: ${primary};
}

/* 危险按钮 */
QPushButton[danger="true"] {
    background-color: ${danger};
    color: white;
}

QPushButton[danger="true"]:hover {
    background-color: #DC2626;
}

/* 成功按钮 */
QPushButton[success="true"] {
    background-color: ${success};
    color: white;
}

QPushButton[success="true"]:hover {
    background-color: #059669;
}

/* 图标按钮 */
QPushButton[icon="true"] {
    background-color: transparent;
    color: ${textSecondary};
    border-radius: 4px;
    padding: 4px;
}

QPushButton[icon="true"]:hover,
QPushButton[icon="true"]:checked {
    background-color: ${primary};
    color: white;
}

/* ==================== 输入框 ==================== */
QLineEdit {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 8px 12px;
    color: ${textPrimary};
    selection-background-color: ${primary};
}

QLineEdit:hover {
    border-color: rgba(0, 0, 0, 0.2);
}

QLineEdit:focus {
    border-color: ${primary};
}

QLineEdit:disabled {
    background-color: ${bgSurface};
    color: ${textDisabled};
}

/* ==================== 下拉框 ==================== */
QComboBox {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 32px;
    color: ${textPrimary};
}

QComboBox:hover {
    border-color: rgba(0, 0, 0, 0.2);
}

QComboBox:focus {
    border-color: ${primary};
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 4px;
    selection-background-color: rgba(59, 130, 246, 0.2);
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: ${textPrimary};
}

QComboBox QAbstractItemView::item:hover {
    background-color: ${bgSurface};
}

/* ==================== 表格 ==================== */
QTableView, QTableWidget {
    background-color: ${bgSecondary};
    alternate-background-color: ${bgSurface};
    border: 1px solid ${border};
    border-radius: 6px;
    gridline-color: ${border};
    selection-background-color: rgba(59, 130, 246, 0.2);
    selection-color: ${textPrimary};
    outline: none;
}

QTableView::item, QTableWidget::item {
    padding: 10px 14px;
    color: ${textPrimary};
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: ${bgSurface};
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.15);
    color: ${textPrimary};
}

QHeaderView::section {
    background-color: ${bgSurface};
    color: ${textSecondary};
    border: none;
    border-bottom: 1px solid ${border};
    padding: 12px 14px;
    font-weight: 500;
    font-size: 12px;
}

QHeaderView::section:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: ${textPrimary};
}

/* ==================== 涨跌颜色 ==================== */
.up, [status="up"], [trend="up"] {
    color: ${danger};
}

.down, [status="down"], [trend="down"] {
    color: ${success};
}

.flat, [status="flat"], [trend="flat"] {
    color: ${textSecondary};
}

/* ==================== 菜单 ==================== */
QMenu {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 8px;
    padding: 8px;
}

QMenu::item {
    color: ${textPrimary};
    padding: 10px 16px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: ${bgSurface};
    color: ${textPrimary};
}

QMenu::item:disabled {
    color: ${textDisabled};
}

QMenu::separator {
    height: 1px;
    background-color: ${border};
    margin: 4px 8px;
}

/* ==================== 标签页 ==================== */
QTabWidget::pane {
    border: 1px solid ${border};
    border-radius: 8px;
    background-color: ${bgSecondary};
}

QTabBar::tab {
    background-color: transparent;
    color: ${textSecondary};
    border: none;
    padding: 10px 20px;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: ${textPrimary};
}

QTabBar::tab:selected {
    color: ${primary};
    border-bottom-color: ${primary};
}

/* ==================== 进度条 ==================== */
QProgressBar {
    background-color: ${bgSurface};
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: ${primary};
    border-radius: 4px;
}

/* ==================== 复选框/单选框 ==================== */
QCheckBox {
    color: ${textPrimary};
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid ${border};
    background-color: ${bgSecondary};
}

QCheckBox::indicator:hover {
    border-color: ${primary};
}

QCheckBox::indicator:checked {
    background-color: ${primary};
    border-color: ${primary};
}

QRadioButton {
    color: ${textPrimary};
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid ${border};
    background-color: ${bgSecondary};
}

QRadioButton::indicator:hover {
    border-color: ${primary};
}

QRadioButton::indicator:checked {
    background-color: ${primary};
    border-color: ${primary};
}

/* ==================== 工具提示 ==================== */
QToolTip {
    background-color: ${bgSecondary};
    color: ${textPrimary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}

/* ==================== 分组框 ==================== */
QGroupBox {
    color: ${textPrimary};
    font-weight: 600;
    border: 1px solid ${border};
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 14px 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: ${bgPrimary};
    color: ${textPrimary};
}

/* ==================== 列表 ==================== */
QListWidget {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 6px;
    outline: none;
}

QListWidget::item {
    padding: 10px 14px;
    border-radius: 6px;
    color: ${textPrimary};
}

QListWidget::item:hover {
    background-color: ${bgSurface};
}

QListWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.15);
    color: ${textPrimary};
}

/* ==================== 文本编辑 ==================== */
QTextEdit, QPlainTextEdit {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 10px;
    color: ${textPrimary};
    selection-background-color: ${primary};
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: ${primary};
}

/* ==================== 对话框 ==================== */
QDialog {
    background-color: ${bgPrimary};
}

QMessageBox {
    background-color: ${bgPrimary};
}

QMessageBox QLabel {
    color: ${textPrimary};
}

/* ==================== 标题栏 ==================== */
TitleBarWidget {
    background-color: ${bgPrimary};
    border-bottom: 1px solid ${border};
}

TitleBarWidget QPushButton {
    background-color: transparent;
    border-radius: 4px;
}

TitleBarWidget QPushButton:hover {
    background-color: ${bgSurface};
}

TitleBarWidget QPushButton#closeBtn:hover {
    background-color: ${danger};
    color: white;
}

/* ==================== 侧边栏 ==================== */
SidebarWidget {
    background-color: ${bgSecondary};
    border-right: 1px solid ${border};
}

SidebarWidget QPushButton {
    background-color: transparent;
    color: ${textSecondary};
    border: none;
    border-left: 3px solid transparent;
    padding: 14px 20px;
    text-align: left;
}

SidebarWidget QPushButton:hover {
    background-color: ${bgSurface};
    color: ${textPrimary};
}

SidebarWidget QPushButton:checked {
    background-color: rgba(59, 130, 246, 0.15);
    color: ${primary};
    border-left-color: ${primary};
}

/* ==================== 状态栏 ==================== */
StatusBarWidget {
    background-color: ${bgSecondary};
    border-top: 1px solid ${border};
}

StatusBarWidget QLabel {
    color: ${textSecondary};
    font-size: 12px;
    padding: 0 8px;
}

StatusBarWidget QLabel#aiStatus {
    color: ${success};
}

StatusBarWidget QLabel#ctpStatus {
    color: ${danger};
}

StatusBarWidget QLabel#ctpStatus[connected="true"] {
    color: ${success};
}

/* ==================== 卡片 ==================== */
CardWidget {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 12px;
}

CardWidget:hover {
    border-color: ${primary};
}

/* ==================== 数字输入框 ==================== */
QSpinBox, QDoubleSpinBox {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 6px 10px;
    color: ${textPrimary};
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: ${primary};
}

/* ==================== 日期时间控件 ==================== */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 6px 10px;
    padding-right: 24px;
    color: ${textPrimary};
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border-color: ${primary};
}

/* ==================== 树形视图 ==================== */
QTreeView, QTreeWidget {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 6px;
    outline: none;
}

QTreeView::item, QTreeWidget::item {
    padding: 8px;
    border-radius: 4px;
    color: ${textPrimary};
}

QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: ${bgSurface};
}

QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.15);
    color: ${textPrimary};
}
