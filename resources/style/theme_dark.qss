/**
 * WealthPilot 深色主题样式表 v6.0
 * 基于 WealthPilot UI 设计规范
 * 
 * 颜色变量（由 ThemeManager 替换）：
 * ${bgPrimary} - 主背景色: #0d1117
 * ${bgSecondary} - 次背景色: #161b22
 * ${bgElevated} - 提升背景色: #161b22
 * ${bgSurface} - 表面背景色: #1c2128
 * ${textPrimary} - 主文本色: #e6edf3
 * ${textSecondary} - 次文本色: #8b949e
 * ${primary} - 主品牌色: #58a6ff
 * ${success} - 成功/上涨色: #3fb950
 * ${danger} - 危险/下跌色: #f85149
 * ${warning} - 警告色: #f0883e
 * ${border} - 边框色: #30363d
 * ${accent} - 强调色: #a371f7
 */

/* ==================== 全局样式 ==================== */
QWidget {
    background-color: ${bgPrimary};
    color: ${textPrimary};
    font-family: 'Roboto', 'Microsoft YaHei', 'PingFang SC', sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: ${bgPrimary};
}

/* ==================== 滚动条 ==================== */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 4px 2px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 0.25);
}

QScrollBar::handle:vertical:pressed {
    background-color: rgba(255, 255, 255, 0.35);
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 2px 4px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.25);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==================== 按钮 ==================== */
QPushButton {
    background-color: transparent;
    color: ${textPrimary};
    border: none;
    padding: 10px 20px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QPushButton:pressed {
    background-color: ${border};
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.02);
    color: ${textDisabled};
}

/* 主按钮 */
QPushButton[primary="true"] {
    background-color: ${primary};
    color: white;
    font-weight: bold;
}

QPushButton[primary="true"]:hover {
    background-color: ${primaryHover};
}

QPushButton[primary="true"]:pressed {
    background-color: ${primaryDark};
}

/* 次要按钮 */
QPushButton[secondary="true"] {
    background-color: ${bgElevated};
    color: ${textPrimary};
    border: 1px solid ${border};
}

QPushButton[secondary="true"]:hover {
    background-color: ${bgHover};
    border-color: ${primary};
}

/* 危险按钮 */
QPushButton[danger="true"] {
    background-color: ${danger};
    color: white;
}

QPushButton[danger="true"]:hover {
    background-color: #DC2626;
}

/* 成功按钮 */
QPushButton[success="true"] {
    background-color: ${success};
    color: white;
}

QPushButton[success="true"]:hover {
    background-color: #059669;
}

/* 图标按钮 */
QPushButton[icon="true"] {
    background-color: transparent;
    color: ${textSecondary};
    border-radius: 4px;
    padding: 4px;
}

QPushButton[icon="true"]:hover,
QPushButton[icon="true"]:checked {
    background-color: ${primary};
    color: ${textPrimary};
}

/* ==================== 输入框 ==================== */
QLineEdit {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 12px;
    padding: 8px 12px;
    color: ${textPrimary};
    selection-background-color: ${primary};
}

QLineEdit:hover {
    border-color: rgba(255, 255, 255, 0.2);
}

QLineEdit:focus {
    border-color: ${primary};
    background-color: rgba(88, 166, 255, 0.05);
}

QLineEdit:disabled {
    background-color: rgba(255, 255, 255, 0.02);
    color: ${textDisabled};
}

/* ==================== 下拉框 ==================== */
QComboBox {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 12px;
    padding: 8px 12px;
    padding-right: 32px;
    color: ${textPrimary};
}

QComboBox:hover {
    border-color: rgba(255, 255, 255, 0.2);
}

QComboBox:focus {
    border-color: ${primary};
}

QComboBox::drop-down {
    border: none;
    width: 28px;
    padding-right: 8px;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron_down.svg);
    width: 16px;
    height: 16px;
}

QComboBox QAbstractItemView {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 12px;
    padding: 4px;
    selection-background-color: rgba(88, 166, 255, 0.2);
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 8px;
    color: ${textPrimary};
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

/* ==================== 表格 ==================== */
QTableView, QTableWidget {
    background-color: transparent;
    alternate-background-color: rgba(255, 255, 255, 0.02);
    border: none;
    gridline-color: ${border};
    selection-background-color: rgba(88, 166, 255, 0.2);
    selection-color: ${textPrimary};
    outline: none;
}

QTableView::item, QTableWidget::item {
    padding: 10px 14px;
    color: ${textPrimary};
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: rgba(88, 166, 255, 0.15);
    color: ${textPrimary};
}

QHeaderView::section {
    background-color: ${bgSecondary};
    color: ${textSecondary};
    border: none;
    border-bottom: 1px solid ${border};
    padding: 12px 14px;
    font-weight: 500;
    font-size: 12px;
}

QHeaderView::section:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: ${textPrimary};
}

/* ==================== 卡片 ==================== */
CardWidget {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 12px;
}

CardWidget:hover {
    border-color: rgba(88, 166, 255, 0.4);
}

CardWidget[theme="success"] {
    border-color: rgba(63, 185, 80, 0.3);
}

CardWidget[theme="warning"] {
    border-color: rgba(240, 136, 62, 0.3);
}

CardWidget[theme="danger"] {
    border-color: rgba(248, 81, 73, 0.3);
}

CardWidget[theme="primary"] {
    border-color: rgba(88, 166, 255, 0.3);
}

/* ==================== 涨跌颜色 ==================== */
.up, [status="up"], [trend="up"] {
    color: ${danger};
}

.down, [status="down"], [trend="down"] {
    color: ${success};
}

.flat, [status="flat"], [trend="flat"] {
    color: ${textSecondary};
}

.bg-up {
    background-color: rgba(248, 81, 73, 0.1);
}

.bg-down {
    background-color: rgba(63, 185, 80, 0.1);
}

/* ==================== 标题栏 ==================== */
TitleBarWidget {
    background-color: ${bgPrimary};
    border-bottom: 1px solid ${border};
}

TitleBarWidget QPushButton {
    background-color: transparent;
    border-radius: 4px;
}

TitleBarWidget QPushButton:hover {
    background-color: ${primary};
}

TitleBarWidget QPushButton#closeBtn:hover {
    background-color: ${danger};
}

/* ==================== 侧边栏 ==================== */
SidebarWidget {
    background-color: ${bgSecondary};
    border-right: 1px solid ${border};
}

SidebarWidget QPushButton {
    background-color: transparent;
    color: ${textSecondary};
    border: none;
    border-left: 3px solid transparent;
    padding: 14px 20px;
    text-align: left;
}

SidebarWidget QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: ${textPrimary};
}

SidebarWidget QPushButton:checked {
    background-color: rgba(88, 166, 255, 0.15);
    color: ${primary};
    border-left-color: ${primary};
}

/* ==================== 状态栏 ==================== */
StatusBarWidget {
    background-color: ${bgSecondary};
    border-top: 1px solid ${border};
}

StatusBarWidget QLabel {
    color: ${textSecondary};
    font-size: 12px;
    padding: 0 8px;
}

StatusBarWidget QLabel#aiStatus {
    color: ${success};
}

StatusBarWidget QLabel#ctpStatus {
    color: ${danger};
}

StatusBarWidget QLabel#ctpStatus[connected="true"] {
    color: ${success};
}

/* ==================== 菜单 ==================== */
QMenu {
    background-color: ${bgSecondary};
    border: 1px solid ${border};
    border-radius: 12px;
    padding: 8px;
}

QMenu::item {
    color: ${textPrimary};
    padding: 10px 16px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: rgba(88, 166, 255, 0.2);
    color: ${textPrimary};
}

QMenu::item:disabled {
    color: ${textDisabled};
}

QMenu::separator {
    height: 1px;
    background-color: ${border};
    margin: 4px 8px;
}

/* ==================== 标签页 ==================== */
QTabWidget::pane {
    border: 1px solid ${border};
    border-radius: 12px;
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: ${textSecondary};
    border: none;
    padding: 10px 20px;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: ${textPrimary};
}

QTabBar::tab:selected {
    color: ${primary};
    border-bottom-color: ${primary};
}

/* ==================== 进度条 ==================== */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: ${primary};
    border-radius: 4px;
}

QProgressBar[success="true"]::chunk {
    background-color: ${success};
}

QProgressBar[danger="true"]::chunk {
    background-color: ${danger};
}

/* ==================== 复选框/单选框 ==================== */
QCheckBox {
    color: ${textPrimary};
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid ${border};
    background-color: transparent;
}

QCheckBox::indicator:hover {
    border-color: ${primary};
}

QCheckBox::indicator:checked {
    background-color: ${primary};
    border-color: ${primary};
}

QRadioButton {
    color: ${textPrimary};
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid ${border};
    background-color: transparent;
}

QRadioButton::indicator:hover {
    border-color: ${primary};
}

QRadioButton::indicator:checked {
    background-color: ${primary};
    border-color: ${primary};
}

/* ==================== 滑块 ==================== */
QSlider::groove:horizontal {
    height: 4px;
    background-color: ${border};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    background-color: ${primary};
    border-radius: 8px;
    margin: -6px 0;
}

QSlider::handle:horizontal:hover {
    background-color: ${primaryHover};
}

QSlider::sub-page:horizontal {
    background-color: ${primary};
    border-radius: 2px;
}

/* ==================== 工具提示 ==================== */
QToolTip {
    background-color: ${bgSecondary};
    color: ${textPrimary};
    border: 1px solid ${border};
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
}

/* ==================== 分组框 ==================== */
QGroupBox {
    color: ${textPrimary};
    font-weight: 600;
    border: 1px solid ${border};
    border-radius: 12px;
    margin-top: 12px;
    padding: 16px 14px 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: ${bgPrimary};
    color: ${textPrimary};
}

/* ==================== 列表 ==================== */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    padding: 10px 14px;
    border-radius: 8px;
    color: ${textPrimary};
}

QListWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QListWidget::item:selected {
    background-color: rgba(88, 166, 255, 0.15);
    color: ${textPrimary};
}

/* ==================== 文本编辑 ==================== */
QTextEdit, QPlainTextEdit {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 12px;
    padding: 10px;
    color: ${textPrimary};
    selection-background-color: ${primary};
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: ${primary};
}

/* ==================== 对话框 ==================== */
QDialog {
    background-color: ${bgPrimary};
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

QMessageBox {
    background-color: ${bgPrimary};
}

QMessageBox QLabel {
    color: ${textPrimary};
}

/* ==================== 分隔线 ==================== */
DividerWidget[frameType="horizontal"] {
    min-height: 1px;
    max-height: 1px;
    background-color: ${border};
}

DividerWidget[frameType="vertical"] {
    min-width: 1px;
    max-width: 1px;
    background-color: ${border};
}

/* ==================== 主题切换按钮 ==================== */
ThemeToggleButton {
    background-color: transparent;
    border: 1px solid ${border};
    border-radius: 15px;
}

ThemeToggleButton:hover {
    border-color: rgba(88, 166, 255, 0.3);
}

/* ==================== 标签样式 ==================== */
QLabel#titleLabel {
    font-size: 20px;
    font-weight: bold;
    color: ${textPrimary};
}

QLabel#subtitleLabel {
    font-size: 14px;
    color: ${textSecondary};
}

QLabel#valueLabel {
    font-size: 18px;
    font-weight: bold;
    color: ${textPrimary};
}

QLabel#labelText {
    font-size: 12px;
    color: ${textSecondary};
}

QLabel#statCard {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 12px;
    padding: 12px;
}

/* ==================== 页面特定样式 ==================== */
DashboardPage {
    background-color: transparent;
}

DashboardPage QLabel#DashboardPageTitle {
    font-size: 24px;
    font-weight: bold;
    color: ${textPrimary};
}

DashboardPage QPushButton#primaryButton {
    background-color: ${primary};
    color: white;
    border-radius: 6px;
    font-weight: bold;
    padding: 10px 20px;
}

DashboardPage QPushButton#primaryButton:hover {
    background-color: ${primaryHover};
}

DashboardPage .AssetCardWidget {
    border: 1px solid ${bgElevated};
    border-radius: 15px;
}

FuturesQuotesPage {
    background-color: transparent;
}

FuturesQuotesPage QLabel#statusLabel {
    color: ${textTertiary};
    padding: 5px;
    border-top: 1px solid ${border};
}

FuturesQuotesPage QPushButton#subscribeBtn {
    background-color: ${primary};
    color: white;
    border-radius: 4px;
    padding: 6px 12px;
}

SettingsPage {
    background-color: transparent;
}

SettingsPage QGroupBox {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 12px;
    margin-top: 16px;
    padding: 16px;
}

AboutUSPage {
    background-color: transparent;
}

AboutUSPage CardWidget {
    background-color: ${bgElevated};
    border: 1px solid ${border};
}

/* ==================== 数字输入框 ==================== */
QSpinBox, QDoubleSpinBox {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 12px;
    padding: 6px 10px;
    color: ${textPrimary};
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: ${primary};
}

/* ==================== 日期时间控件 ==================== */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: ${bgElevated};
    border: 1px solid ${border};
    border-radius: 12px;
    padding: 6px 10px;
    padding-right: 24px;
    color: ${textPrimary};
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border-color: ${primary};
}

/* ==================== 树形视图 ==================== */
QTreeView, QTreeWidget {
    background-color: transparent;
    border: none;
    outline: none;
}

QTreeView::item, QTreeWidget::item {
    padding: 8px;
    border-radius: 4px;
    color: ${textPrimary};
}

QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: rgba(88, 166, 255, 0.15);
    color: ${textPrimary};
}
