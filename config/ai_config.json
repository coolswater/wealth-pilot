{
  "ai": {
    "provider": "zhipu",
    "models": {
      "chat": {
        "model": "glm-4",
        "maxTokens": 4096,
        "temperature": 0.7,
        "topP": 0.9
      },
      "analysis": {
        "model": "glm-4-flash",
        "maxTokens": 2048,
        "temperature": 0.3,
        "topP": 0.95
      }
    },
    "apiKeys": {
      "zhipu": "",
      "openai": "",
      "anthropic": ""
    },
    "settings": {
      "requestTimeout": 30000,
      "maxRetries": 3,
      "retryDelay": 1000,
      "cacheEnabled": true,
      "cacheTTL": 3600
